# Required
ADMIN_PASSWORD=change-me-long-and-random
SESSION_SECRET=another-long-random-string
BASE_URL=https://your-domain.example
# Storage (use a persistent disk path in production)
DB_PATH=./data/cca.db
PORT=3000
# Email (optional: without these, emails queue in the outbox and the number is still shown on screen)
RESEND_API_KEY=
MAIL_FROM="Gold Coast Games <hello@your-domain.example>"
# Defaults for timings (editable in /admin). Accra = UTC+0 all year, so write times in UTC.
EVENT_STARTS_AT=2026-11-30T08:00:00Z
FINAL_OPENS_AT=
FINAL_CLOSES_AT=
# Set to 1 when behind a proxy (Render/Fly/Railway) so rate limiting sees real IPs
TRUST_PROXY=1
